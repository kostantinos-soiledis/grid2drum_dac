# Paper sources stay local only
/paper/

# Compiled manuscript drafts (submission PDFs live with the paper sources)
/*.pdf

# Final evaluation keeps tables and per-clip metrics, not regenerable audio.
/results/final/**/wavs/
/results/final/**/target_audio_cache/
/results/final/**/fad_assets/
/results/final/**/eval_input/
/results/final/**/per_clip_metrics.jsonl
/runs/final/exports/**/wavs/

# Final runs ship configs and histories only. The demo's checkpoints, which are
# byte-identical to postsnap_pca, grid_hz/250hz and regression_6layer, stay
# tracked under their original runs/ paths (see runs/weights/manifest.json).
/runs/final/**/*.pt

# E-GMD kit ablation: keep build reports, run configs/histories and result
# tables; caches, checkpoints and audio are rebuilt by run_kit_ablation.sh.
/egmd_kit_ablation/*/cache_dac/
/egmd_kit_ablation/*/cache_sao/
/egmd_kit_ablation/*/reference_audio/
/egmd_kit_ablation/*/reference_audio_validation/
/egmd_kit_ablation/*/exports/
/egmd_kit_ablation/*/runs/**/*.pt
/egmd_kit_ablation/*/runs/**/best_samples/
/egmd_kit_ablation/*/runs/**/eval_plots/
/egmd_kit_ablation/*/results/**/eval_input/
/egmd_kit_ablation/*/results/**/fad_assets/
/egmd_kit_ablation/*/results/**/wavs/
/egmd_kit_ablation/*/results/**/per_clip_metrics.jsonl

# Training byproducts
/runs/**/best_samples/
/runs/**/eval_plots/
/runs/**/last.pt

