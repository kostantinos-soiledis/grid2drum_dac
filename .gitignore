# Paper sources stay local only
/paper/

# Compiled manuscript drafts (submission PDFs live with the paper sources)
/*.pdf

# Static listening page: published only from the `anonymous` branch
/docs/

# Final evaluation keeps tables and per-clip metrics, not regenerable audio.
/results/final/**/wavs/
/results/final/**/target_audio_cache/
/results/final/**/fad_assets/
/results/final/**/eval_input/
/results/final/**/per_clip_metrics.jsonl
/runs/final/exports/**/wavs/

# Final runs ship configs and histories only. The demo's checkpoints, which are
# byte-identical to postsnap_pca, grid_hz/250hz and regression_6layer, stay
# tracked under their original runs/ paths (see runs/weights/manifest.json).
/runs/final/**/*.pt

# Training byproducts
/runs/**/best_samples/
/runs/**/eval_plots/
/runs/**/last.pt

# Local archive created by the results reset; retired code stays in git history
/obsolete/

# Local datasets, third-party models, and standalone experiments
/magenta_model/
/egmd_kit_ablation/
/tria_moises_db/
/sao_stereo/

# TRIA: keep source, run summaries, and result tables; regenerate local artifacts
/tria_finetune_gmd/upstream/
/tria_finetune_gmd/.venv_kad/
/tria_finetune_gmd/manifests/
/tria_finetune_gmd/gmd_long.yml
/tria_finetune_gmd/gmd_long_160k.yml
/tria_finetune_gmd/runs/**/*.pt
/tria_finetune_gmd/runs/*/logs/
/tria_finetune_gmd/runs/*/log.txt
/tria_finetune_gmd/predictions/
/tria_finetune_gmd/results/evaluation/
/tria_finetune_gmd/results/*/evaluation/
/tria_finetune_gmd/logs/

# Dataset caches: rebuild with code/experiment/scripts/build_*_cache.py
/caches/

# Standalone Grid2Drum Space (GrooVAE + Grid2Groove), kept out of the repo
/hf_demo/
