# Final evaluation keeps tables and per-clip metrics, not regenerable audio.
/results/final/**/wavs/
/results/final/**/target_audio_cache/
/results/final/**/fad_assets/
/results/final/**/eval_input/
/results/final/**/per_clip_metrics.jsonl
/runs/final/exports/**/wavs/

# Final runs ship configs and histories only. The demo's checkpoints, which are
# byte-identical to postsnap_pca, grid_hz/250hz and regression_6layer, stay
# tracked under their original runs/ paths (see runs/weights/manifest.json).
/runs/final/**/*.pt

# Training byproducts
/runs/**/best_samples/
/runs/**/eval_plots/
/runs/**/last.pt

# Local archive created by the results reset; retired code stays in git history
/obsolete/

/magenta_model
