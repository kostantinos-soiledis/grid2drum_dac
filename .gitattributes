# Model weights (>100 MB) MUST use Git LFS on GitHub
*.pt        filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Qualitative demo/comparison audio (kept out of the git object store)
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text

# The former GitHub Pages demo site and its single-kit examples are no longer
# tracked (see .gitignore); the hosted Hugging Face listener replaces them, so
# the plain-blob overrides they needed have been removed.
